SELECT Diff, Name, RegistryPath, Command
FROM diff(
  query={
    SELECT Name,
           OSPath.String AS RegistryPath,
           Data.Value AS Command
    FROM glob(
      globs='''HKEY_USERS\*\SOFTWARE\Microsoft\Windows\CurrentVersion\Run\*''',
      accessor="registry"
    )
    WHERE Name = "VR_Lab_Test"
  },
  key="RegistryPath",
  period=15
)
WHERE Diff = "added"
LIMIT 1
